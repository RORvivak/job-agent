<%= form_with url: url, method: method, style: "max-width:600px" do |f| %>

  <div style="margin-bottom:16px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">
      Set Name <span style="font-weight:normal; color:#888">(e.g. "Rails Jobs", "AI Engineer")</span>
    </label>
    <input type="text" name="name" value="<%= pref.name %>" required
      placeholder="Rails Jobs"
      style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
  </div>

  <div style="margin-bottom:16px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">
      Desired Roles <span style="font-weight:normal; color:#888">(comma-separated — LinkedIn search keywords)</span>
    </label>
    <input type="text" name="desired_roles_raw" value="<%= pref.desired_roles&.join(', ') %>"
      placeholder="Ruby on Rails Engineer, Senior Backend Engineer"
      style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
  </div>

  <div style="margin-bottom:16px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">
      Preferred Stack <span style="font-weight:normal; color:#888">(AI uses this to rank job matches)</span>
    </label>
    <input type="text" name="preferred_stack_raw" value="<%= pref.preferred_stack&.join(', ') %>"
      placeholder="Ruby, Rails, PostgreSQL, Redis"
      style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
  </div>

  <div style="margin-bottom:16px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">
      Locations <span style="font-weight:normal; color:#888">(leave empty for any)</span>
    </label>
    <input type="text" name="locations_raw" value="<%= pref.locations&.join(', ') %>"
      placeholder="Remote, San Francisco"
      style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
  </div>

  <div style="display:flex; gap:16px; margin-bottom:16px">
    <div style="flex:1">
      <label style="display:block; font-weight:bold; margin-bottom:4px">Remote Preference</label>
      <select name="remote_preference" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
        <% ["remote", "hybrid", "onsite"].each do |opt| %>
          <option value="<%= opt %>" <%= "selected" if pref.remote_preference == opt %>><%= opt.capitalize %></option>
        <% end %>
      </select>
    </div>
    <div style="flex:1">
      <label style="display:block; font-weight:bold; margin-bottom:4px">Years Experience</label>
      <input type="number" name="years_experience" value="<%= pref.years_experience %>"
        placeholder="5"
        style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
    </div>
  </div>

  <div style="display:flex; gap:16px; margin-bottom:16px">
    <div style="flex:1">
      <label style="display:block; font-weight:bold; margin-bottom:4px">Min Salary ($)</label>
      <input type="number" name="salary_min" value="<%= pref.salary_min %>"
        placeholder="120000"
        style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
    </div>
    <div style="flex:1">
      <label style="display:block; font-weight:bold; margin-bottom:4px">Max Salary ($)</label>
      <input type="number" name="salary_max" value="<%= pref.salary_max %>"
        placeholder="200000"
        style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
    </div>
  </div>

  <div style="margin-bottom:16px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">
      Additional Info <span style="font-weight:normal; color:#888">(visa status, notice period, etc. — used in cover letters)</span>
    </label>
    <textarea name="additional_info" rows="3"
      placeholder="US citizen, available immediately, open to equity"
      style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px"><%= pref.additional_info %></textarea>
  </div>

  <div style="margin-bottom:24px">
    <label style="display:flex; align-items:center; gap:8px; cursor:pointer">
      <input type="checkbox" name="active" value="1" <%= "checked" if pref.active != false %>>
      <span style="font-weight:bold">Active</span>
      <span style="color:#888; font-size:13px">(agent uses this set when running)</span>
    </label>
  </div>

  <div style="display:flex; gap:12px; align-items:center">
    <button type="submit" style="background:#1a1a1a; color:#fff; padding:10px 24px; border:none; border-radius:4px; cursor:pointer; font-size:14px">
      Save
    </button>
    <%= link_to "Cancel", preferences_path, style: "color:#555; font-size:14px" %>
  </div>
<% end %>
