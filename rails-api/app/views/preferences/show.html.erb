<h2>Preferences</h2>
<p style="color:#555; margin-bottom:24px;">These settings drive what jobs the agent searches for and how it applies.</p>

<%= form_with url: preferences_path, method: :post, style: "max-width:600px" do |f| %>

  <div style="margin-bottom:20px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">
      Desired Roles <span style="font-weight:normal; color:#888">(comma-separated — used as LinkedIn search keywords)</span>
    </label>
    <input type="text" name="desired_roles_raw"
      value="<%= @pref.desired_roles&.join(', ') %>"
      placeholder="Ruby on Rails Engineer, Senior Backend Engineer"
      style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
  </div>

  <div style="margin-bottom:20px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">
      Preferred Stack <span style="font-weight:normal; color:#888">(used by AI to rank jobs)</span>
    </label>
    <input type="text" name="preferred_stack_raw"
      value="<%= @pref.preferred_stack&.join(', ') %>"
      placeholder="Ruby, Rails, PostgreSQL, Redis"
      style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
  </div>

  <div style="margin-bottom:20px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">
      Locations <span style="font-weight:normal; color:#888">(leave empty for any)</span>
    </label>
    <input type="text" name="locations_raw"
      value="<%= @pref.locations&.join(', ') %>"
      placeholder="Remote, San Francisco, New York"
      style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
  </div>

  <div style="margin-bottom:20px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">Remote Preference</label>
    <select name="remote_preference" style="padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
      <% ["remote", "hybrid", "onsite"].each do |opt| %>
        <option value="<%= opt %>" <%= "selected" if @pref.remote_preference == opt %>><%= opt.capitalize %></option>
      <% end %>
    </select>
  </div>

  <div style="display:flex; gap:16px; margin-bottom:20px">
    <div style="flex:1">
      <label style="display:block; font-weight:bold; margin-bottom:4px">Years of Experience</label>
      <input type="number" name="years_experience" value="<%= @pref.years_experience %>"
        placeholder="5"
        style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
    </div>
    <div style="flex:1">
      <label style="display:block; font-weight:bold; margin-bottom:4px">Min Salary ($)</label>
      <input type="number" name="salary_min" value="<%= @pref.salary_min %>"
        placeholder="120000"
        style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
    </div>
    <div style="flex:1">
      <label style="display:block; font-weight:bold; margin-bottom:4px">Max Salary ($)</label>
      <input type="number" name="salary_max" value="<%= @pref.salary_max %>"
        placeholder="200000"
        style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px">
    </div>
  </div>

  <div style="margin-bottom:24px">
    <label style="display:block; font-weight:bold; margin-bottom:4px">
      Additional Info <span style="font-weight:normal; color:#888">(anything extra for the AI — visa status, notice period, etc.)</span>
    </label>
    <textarea name="additional_info" rows="3"
      placeholder="US citizen, available immediately, open to equity"
      style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; font-size:14px"><%= @pref.additional_info %></textarea>
  </div>

  <button type="submit" style="background:#1a1a1a; color:#fff; padding:10px 24px; border:none; border-radius:4px; cursor:pointer; font-size:14px">
    Save Preferences
  </button>
<% end %>
